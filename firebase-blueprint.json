{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered member account with wallet balance and investment state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "balance": { "type": "number" },
        "totalDeposited": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "totalProfitEarned": { "type": "number" },
        "referralEarnings": { "type": "number" },
        "role": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "fullName", "phone"]
    },
    "Deposit": {
      "title": "Deposit",
      "description": "User deposit transaction request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "transactionId": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "User withdrawal cashout request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of all registered users"
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/Deposit" },
      "description": "Collection of deposit requests"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Collection of withdrawal requests"
    }
  }
}
